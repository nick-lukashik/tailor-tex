{
    "name": "tailor-tex",
    "version": "0.1.0",
    "private": true,
    "description": "Internal service of Tailor: CV data to PDF with XeLaTeX (Minimal violet template), measured with poppler",
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26.13.0",
        "pnpm": ">=12.16.1"
    },
    "scripts": {
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "build": "pnpm clean && tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "dev": "pnpm build && pnpm run \"/^dev:/\"",
        "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "dev:node": "node --env-file-if-exists=.env --watch-path=dist dist/main.js",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:int": "vitest run --project integration",
        "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
        "env:local": "node -e \"fs.existsSync('.env')?console.log('.env already exists'):(fs.copyFileSync('.env.example','.env'),console.log('created .env from .env.example'))\"",
        "docker:up": "docker compose up -d --build --wait",
        "docker:down": "docker compose down"
    },
    "dependencies": {
        "@nestjs/common": "12.3.2",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "12.3.2",
        "@nestjs/platform-express": "12.3.2",
        "@nestjs/swagger": "12.0.5",
        "@nestjs/terminus": "12.1.0",
        "@prometheus-io/client": "0.16.1",
        "nestjs-pino": "5.3.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@nestjs/testing": "12.3.2",
        "@standard-schema/spec": "1.1.0",
        "@swc/core": "1.16.21",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@types/supertest": "7.2.1",
        "supertest": "7.3.1",
        "typescript": "7.0.2",
        "unplugin-swc": "2.0.0",
        "vitest": "5.0.5"
    }
}
