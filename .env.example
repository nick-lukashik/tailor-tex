# Copy to .env with `pnpm env:local`. In Kubernetes variables come from the ConfigMap
# <svc>-config and the SealedSecret <svc>-secrets (envFrom), not from a file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=dev
# Port of the separate Prometheus listener (GET /metrics); 0 turns it off.
METRICS_PORT=9464
# Proxy hops in front of the service (0 locally, 1 behind one ingress); used for client IPs.
TRUST_PROXY_HOPS=0
# Delay before shutdown after SIGTERM so the load balancer drops the pod first (ms).
# 0 in Kubernetes: the pod's preStop sleep does that.
SHUTDOWN_DELAY_MS=0

# XeLaTeX builds at once; with every slot busy a build is refused with 429 (or
# waits, up to TEX_QUEUE_MAX builds).
TEX_CONCURRENCY=2
TEX_QUEUE_MAX=0
# One whole build: two xelatex runs and poppler (504 after it); under the 60 s request budget.
TEX_TIMEOUT_MS=45000
# Parent of the per-build folders (default: the OS temp dir, /tmp in the image).
# TEX_WORK_DIR=

# Secret: no default in code. Bearer token of the callers (Tailor's API), at least
# 32 characters. The value below is for local use only; make your own with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=local-only-token-change-me-0123456789abcdef
